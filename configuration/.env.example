# Server-only configuration. Use .dev.vars locally; Cloudflare encrypted secrets in deployment.
APP_ORIGIN=http://localhost:8788
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Paystack test keys only. sk_live keys are explicitly rejected.
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=
TEAM_INBOX=
# Random >=32-character secret for IP hashing and guest order capabilities.
APP_SECRET=
# Random >=32-character bearer credential for authenticated outbox/reconciliation jobs.
JOB_SECRET=

# Stage 3 controls: keep indexing and HSTS disabled until the hosted checks pass.
APP_ENV=development
PUBLIC_INDEXING_ENABLED=false
HTTPS_VERIFIED=false
# Owner-approved operations alert inbox. Presence does not prove email delivery.
OPS_INBOX=
# HTTPS malware scanner: POST bytes, bearer token, X-Content-SHA256; response must
# be {"sha256":"matching hash","verdict":"clean"} or "rejected".
# Without this integration, new downloadable files stay quarantined.
SCANNER_URL=
SCANNER_TOKEN=
