# Dedicated backup/isolated restore environment; server-only, never static assets.
# Fill securely in the backup runner; owner-approved retention is required.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=
JOB_SECRET=
BACKUP_S3_ENDPOINT=
BACKUP_BUCKET=
BACKUP_REGION=auto
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_SESSION_TOKEN=
BACKUP_PUBLIC_KEY_FILE=
BACKUP_RETENTION_DAYS=
# Optional trusted custom PostgreSQL CA path; TLS verification remains mandatory.
PGSSLROOTCERT=
# Restore only: private key lives outside the backup runner and repository.
BACKUP_PRIVATE_KEY_FILE=
EXPECTED_BACKUP_SHA256=
APP_ENV=staging
RESTORE_CONFIRMATION=
